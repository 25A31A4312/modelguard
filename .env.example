# GEMINI_API_KEY: Optional/Server-side API key for multimodal vision inference.
# In AI Studio this is injected automatically via Secrets. Never commit real keys.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the service is hosted.
APP_URL="http://localhost:3000"

# PORT: HTTP port bound by the Express server (default 3000).
PORT=3000

# MLFLOW_TRACKING_URI: Base URL of a running MLflow Tracking Server (REST API v2.0).
# Leave empty so Docker Compose defaults to http://mlflow:5000 on the internal Compose network.
# For bare-metal host development with a local MLflow server, set to http://127.0.0.1:5000.
MLFLOW_TRACKING_URI=""
MLFLOW_EXPERIMENT_NAME="modelguard-cv-drift-monitoring"

# Statistical Drift & Retraining Thresholds
DRIFT_MIN_SAMPLES=5
AUTO_RETRAIN_KS_ALPHA=0.05
RETRAIN_MIN_LABELED_SAMPLES=6

# Persistent storage path for uploaded images, trained checkpoints, and operational state
# (Overridden to /app/data inside Docker / Docker Compose)
MODELGUARD_DATA_DIR="./data"
